#!/usr/bin/env bash
# Toggle or set the shared light/dark theme for Neovim, tmux, and Ghostty.
# Usage: theme [light|dark|toggle|status]
set -euo pipefail

MODE_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/theme-mode"
GHOSTTY_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/ghostty"
GHOSTTY_THEME_FILE="$GHOSTTY_DIR/theme.conf"
CATPPUCCIN_TMUX="${HOME}/.tmux/plugins/tmux/catppuccin.tmux"
mkdir -p "$(dirname "$MODE_FILE")" "$GHOSTTY_DIR"

current_mode() {
  if [[ -f "$MODE_FILE" ]]; then
    tr -d '[:space:]' <"$MODE_FILE"
  else
    printf 'light'
  fi
}

write_mode() {
  printf '%s\n' "$1" >"$MODE_FILE"
}

flavour_for() {
  if [[ "$1" == "dark" ]]; then
    printf 'mocha'
  else
    printf 'latte'
  fi
}

notify_neovim() {
  local sock
  shopt -s nullglob
  for sock in /tmp/nvim.*/0 "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"/nvim.*/0; do
    [[ -S "$sock" ]] || continue
    nvim --server "$sock" --remote-expr "luaeval(\"require('config.theme').apply()\")" >/dev/null 2>&1 || true
  done
  shopt -u nullglob
}

reload_tmux() {
  if ! tmux list-sessions >/dev/null 2>&1; then
    return
  fi

  local mode flavour
  mode="$(current_mode)"
  flavour="$(flavour_for "$mode")"

  # Catppuccin caches colors; force a full palette rebuild when switching.
  tmux set-option -g @catppuccin_flavor "$flavour"
  tmux set-option -g @catppuccin_window_status_style "rounded"
  tmux set-option -g @catppuccin_window_current_number_color "#{@thm_pink}"
  tmux set-option -g @catppuccin_window_text " #W"
  tmux set-option -g @catppuccin_window_current_text " #W"
  tmux set-option -g @catppuccin_pane_active_border_style "fg=#{@thm_pink}"
  tmux set-option -g @catppuccin_status_background "default"
  tmux set-option -g @catppuccin_reset "true"

  if [[ -f "$CATPPUCCIN_TMUX" ]]; then
    tmux run-shell "$CATPPUCCIN_TMUX"
  else
    tmux source-file "$HOME/.tmux.conf"
    return
  fi

  tmux set-option -g status-left-length 100
  tmux set-option -g status-right-length 100
  tmux set-option -g status-left ""
  tmux set-option -g status-right "#{E:@catppuccin_status_session}"
}

write_ghostty_theme() {
  local mode window_theme ghostty_theme
  mode="$(current_mode)"
  if [[ "$mode" == "dark" ]]; then
    ghostty_theme="Catppuccin Mocha"
    window_theme="dark"
  else
    ghostty_theme="Catppuccin Latte"
    window_theme="light"
  fi

  cat >"$GHOSTTY_THEME_FILE" <<EOF
# Generated by \`theme\` — do not edit by hand.
theme = ${ghostty_theme}
window-theme = ${window_theme}
EOF
}

reload_ghostty() {
  # Ghostty does not watch config files. Since 1.2 it reloads on SIGUSR2.
  local pid
  while read -r pid; do
    [[ -n "$pid" ]] || continue
    kill -USR2 "$pid" 2>/dev/null || true
  done < <(pgrep -x ghostty || true)

  # Fallback for older builds / Accessibility-enabled setups.
  if pgrep -xq ghostty; then
    osascript >/dev/null 2>&1 <<'APPLESCRIPT' || true
tell application "System Events"
  if not (exists process "ghostty") then return
  tell process "ghostty"
    click menu item "Reload Configuration" of menu "Ghostty" of menu bar 1
  end tell
end tell
APPLESCRIPT
  fi
}

apply() {
  local mode
  mode="$(current_mode)"
  case "$mode" in
    light|dark) ;;
    *)
      mode="light"
      write_mode "$mode"
      ;;
  esac
  write_ghostty_theme
  reload_tmux
  reload_ghostty
  notify_neovim
  printf 'theme: %s\n' "$mode"
}

cmd="${1:-toggle}"
case "$cmd" in
  light|dark)
    write_mode "$cmd"
    apply
    ;;
  toggle)
    if [[ "$(current_mode)" == "dark" ]]; then
      write_mode "light"
    else
      write_mode "dark"
    fi
    apply
    ;;
  status)
    printf '%s\n' "$(current_mode)"
    ;;
  *)
    printf 'Usage: theme [light|dark|toggle|status]\n' >&2
    exit 1
    ;;
esac
